# Server port (default: 3000)
PORT=3000

# Frontend URL for CORS in development (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Database path relative to backend/ directory
DATABASE_PATH=./data/altforge.db

# OpenAI API key — required for AI alt-text generation (GPT-4o-mini)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Set to "production" to serve built frontend from ../frontend/dist
# Leave unset for development (uses separate Vite dev server)
NODE_ENV=development
