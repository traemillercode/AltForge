# Server port (default: 3000)
PORT=3000

# Frontend URL for CORS in development (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Database path relative to backend/ directory
DATABASE_PATH=./data/altforge.db

# Anthropic API key — required for AI alt-text generation (Claude 3 Haiku)
# Get your key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Set to "production" to serve built frontend from ../frontend/dist
# Leave unset for development (uses separate Vite dev server)
NODE_ENV=development

# Cloudflare Turnstile secret key (for CAPTCHA verification on free sample)
# Get your keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave unset to skip verification (dev mode — form works without CAPTCHA)
TURNSTILE_SECRET_KEY=
