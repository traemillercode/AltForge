# API base URL for development (default: http://localhost:3000)
# Vite proxies /api to this URL in dev mode
VITE_API_URL=http://localhost:3000

# Cloudflare Turnstile site key (for CAPTCHA on free sample form)
# Get your keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave unset to disable CAPTCHA (form works without it in dev)
VITE_TURNSTILE_SITE_KEY=
